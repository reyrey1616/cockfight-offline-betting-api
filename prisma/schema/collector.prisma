// Cash collector — the person who hands cash advances to tellers and
// receives remittances back from them. NOT a User: collectors do not
// authenticate into the system. Their identity is captured here purely as
// a managed label, referenced from TellerLedger entries (CASH_ADVANCE and
// REMIT) and printed on deposit / remit slips.
//
// Collectors persist across session wipes (same as User rows).
// Use isActive to retire a collector instead of deleting, so historical
// ledger entries remain readable.
model Collector {
  id        String   @id @default(cuid())
  // Public scannable barcode for the cash workflow. 8 chars, format
  // "COL" + 5 reduced-alphabet chars (e.g. "COLA7B2C"). Printed on
  // collector badges / wristbands so admins can scan instead of picking
  // from a dropdown when recording an advance or remit. Generated by
  // src/lib/code-generator.js at create-time; never re-issued.
  code      String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries TellerLedger[]

  @@index([isActive])
}
