# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgresql://betting_app:betting_app_dev_pw@localhost:5432/cockfight_betting?schema=public"

# Supabase backup mirror (optional — local stays source of truth)
SUPABASE_DATABASE_URL="postgresql://postgres:dqgwhugs7iKz4DxV@db.vdzsjhvhuvigpjlhrban.supabase.co:5432/postgres"
SUPABASE_AUTO_SYNC_MINUTES=15
SUPABASE_SYNC_ENABLED=true

# TablePlus: host 127.0.0.1, SSL PREFER, negotiation POSTGRES — or paste URL import:
# postgresql://betting_app:betting_app_dev_pw@127.0.0.1:5432/cockfight_betting?sslmode=prefer

SEED_ADMIN_PASSWORD='admin2026@'
SEED_SYNC_ADMIN_PASSWORD=false
PORT=8000

# JWT signing secret. Rotate this in production (any value here invalidates
# all currently-issued tokens, forcing every user to log in again).
JWT_SECRET="HcOIHTP-vtNnn4WeDk3DNn12I-pzm8wQEVfPqy0Tif6OIKm9CcNIKDWgBAt2uwrT"

# Token lifetime. Long enough for a single shift; short enough that a stolen
# token expires before another shift starts.
JWT_EXPIRES_IN="24h"